{
  "name": "old-vibe",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:prod": "node --env-file=.env.prod node_modules/drizzle-kit/bin.cjs migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --env-file=.env scripts/seed.ts",
    "db:seed-shop": "tsx --env-file=.env scripts/seed-shop.ts",
    "db:seed-shop:prod": "tsx --env-file=.env --env-file=.env.prod scripts/seed-shop.ts",
    "dev:login": "tsx --env-file=.env scripts/dev-login.ts",
    "migrate:report": "tsx --env-file=.env scripts/migrate-report.ts",
    "migrate:import": "tsx --env-file=.env scripts/migrate-import.ts",
    "migrate:beans": "tsx --env-file=.env scripts/migrate-beans.ts",
    "migrate:orders": "tsx --env-file=.env scripts/migrate-orders.ts",
    "migrate:screenshots": "tsx --env-file=.env scripts/migrate-screenshots.ts",
    "migrate:queue": "tsx --env-file=.env scripts/migrate-queue.ts",
    "migrate:unified": "tsx --env-file=.env scripts/migrate-unified.ts",
    "promote": "tsx --env-file=.env --env-file=.env.prod scripts/promote.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3",
    "jose": "^6.2.12",
    "next": "16.3.8",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "prettier": "3.9.9",
    "tsx": "^4.23.15",
    "typescript": "6.0.3"
  }
}
